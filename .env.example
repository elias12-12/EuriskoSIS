# Copy to .env and adjust. .env is untracked (see .gitignore).
#
# The database values below match the defaults baked into docker-compose.yml, so
# you only need this file to change them -- or to supply the model API key in a
# later phase. Never commit real credentials.

POSTGRES_USER=eurisko
POSTGRES_PASSWORD=eurisko_dev
POSTGRES_DB=eurisko
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# The admin panel's shared login (the brief asks for "a separate, simpler login"
# for the administrator, with no per-user accounts). Compose defaults this to
# eurisko_admin so a clean clone runs; it is a real credential anywhere else.
ADMIN_PASSWORD=eurisko_admin

# Required from Phase 3 onward. Two things need model access:
#   - embeddings (text-embedding-3-small), for document ingestion and search
#   - the chat agent
#
# Pick ONE of the two setups below. Neither has a default -- these are real
# secrets and must never be committed. Without one, every record endpoint and the
# whole portal still work; /documents/search and /me/chat return 503 with a
# message naming the key that is missing.

# SETUP A -- Pydantic AI Gateway. One key covers both halves: the agent (via a
# `gateway/openai:gpt-5-mini` model name) and embeddings (via the gateway's
# OpenAI-compatible route). Keys look like `pylf_v2_us_...`, and the base URL is
# derived from the region encoded in the key. Set the model to
# `gateway/openai:gpt-5-mini` in the admin panel's Assistant behaviour tab.
# PYDANTIC_AI_GATEWAY_API_KEY=
# PYDANTIC_AI_GATEWAY_BASE_URL=    # only to override the derived URL

# SETUP B -- a provider key directly. OpenAI keys look like `sk-...`, Anthropic
# like `sk-ant-...`. A gateway `pylf_...` key will NOT authenticate against
# either of these directly. With OPENAI_API_KEY the default model_name
# (`openai:gpt-5-mini`) works unchanged.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=               # only if model_name is an anthropic:* one

# Pydantic Logfire tracing, optional and unread by the code today. Note before
# enabling: traces carry prompts and tool results, i.e. student names, grades and
# schedules, off the machine. Handbook section 4.1 treats records as confidential.
# LOGFIRE_TOKEN=
