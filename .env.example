# Copy to .env and adjust. .env is untracked (see .gitignore).
#
# The database values below match the defaults baked into docker-compose.yml, so
# you only need this file to change them -- or to supply the model API key in a
# later phase. Never commit real credentials.

POSTGRES_USER=eurisko
POSTGRES_PASSWORD=eurisko_dev
POSTGRES_DB=eurisko
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Required from Phase 3 onward. Two things need it:
#   - embeddings (OpenAI text-embedding-3-small), so document ingestion and search
#   - the chat agent, whose default model is openai:gpt-5-mini
# One key therefore runs the whole system. The agent's model is admin-configurable
# in the assistant_settings table, so switching to anthropic:claude-* is an UPDATE
# plus an ANTHROPIC_API_KEY here.
#
# Unlike the Postgres values above there is no usable default -- this is a real
# secret and must never be committed. Without it the Phase 2 endpoints and
# /me/profile, /me/schedule, /me/courses, /me/degree-progress all still work;
# /documents/search returns 503 and /me/chat cannot run.
# OPENAI_API_KEY=
